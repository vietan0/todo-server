{
  "name": "todo-server",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.15.1",
  "description": "",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "check": "npm-run-all -p type lint test:once",
    "coverage": "vitest run --coverage",
    "dev": "npm-run-all -p dev-server postman studio",
    "dev-server": "tsx watch src",
    "dump": "pg_dump -Ccd todo-server -f prisma/dump.sql",
    "gen": "prisma generate && start prisma/erd.svg",
    "lint": "eslint .",
    "mig": "prisma migrate dev --name",
    "postman": "bash postman.sh",
    "prepare": "husky",
    "start": "node dist",
    "studio": "prisma studio",
    "test": "vitest",
    "test:once": "vitest run",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "type": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lexorank": "^1.0.5",
    "morgan": "^1.10.1",
    "tozod": "^3.0.0",
    "zod": "^4.1.7",
    "zod-validation-error": "^4.0.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.3.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@faker-js/faker": "^10.0.0",
    "@mermaid-js/mermaid-cli": "^11.9.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "npm-run-all": "^4.1.5",
    "prisma": "^6.16.0",
    "prisma-erd-generator": "^2.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "puppeteer"
    ]
  },
  "lint-staged": {
    "*.ts": "pnpm exec eslint --fix"
  }
}
